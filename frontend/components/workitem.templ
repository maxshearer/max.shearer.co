package components

import (
	"fmt"
	"html"
)

type WorkItemProps struct {
	Label    string
	Filename string
	Width    int
	Height   int
	AltText  string
}

templ WorkItem(props WorkItemProps) {
	{{
		label := html.UnescapeString(props.Label)
	}}
	<figure class="work-item">
		<picture loading="lazy">
			<source srcset={ fmt.Sprintf("/static/images/%s.avif", props.Filename) } type="image/avif"/>
			<img src={ fmt.Sprintf("/static/images/%s.png", props.Filename) } alt={ props.AltText } width={ fmt.Sprintf("%d", props.Width) } height={ fmt.Sprintf("%d", props.Height) }/>
		</picture>
		<figcaption class="work-item__caption">
			<p>{ label }</p>
		</figcaption>
	</figure>
}
