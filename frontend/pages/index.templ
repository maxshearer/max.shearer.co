package pages

import (
	"github.com/maxshearer/max.shearer.co/frontend/components"
	"github.com/maxshearer/max.shearer.co/frontend/layouts"
)

templ Index() {
	@layouts.Default(layouts.LayoutProps{
		PageID: "index",
		Stylesheets: []string{
			"index.css",
		},
	}) {
		<div class="index">
			<div class="content">
				<h1>Making nice things for mobile and the web. Currently building <a href="https://waywi.se">Waywise</a>.</h1>
				<p>
					I'm a designer and developer with 20 years of experience building for web and mobile. My current work focuses on building applications with Svelte, React Native/Expo, Go, and PostgreSQL.
				</p>
				<p>
					Day-to-day I lead the team building interfaces at <a href="https://www.caura.com" rel="nofollow">Caura</a>, an automotive tech business taking the hassle out of motoring admin.
				</p>
				<p>In my spare time I&rsquo;m building Waywise, an AI-generated travel guidebook for iOS to allow travellers to explore cities in a more personal and socially responsible way.</p>
			</div>
			<section class="work">
				@components.WorkItem(components.WorkItemProps{
					ID:       "waywise",
					Label:    "Waywise: an AI-generated travel guidebook for iOS",
					Filename: "waywise",
					Width:    1000,
					Height:   600,
					AltText:  "Three mobile phone mockups with Waywise travel app displayed",
				})
				@components.WorkItem(components.WorkItemProps{
					ID:       "yard-poker",
					Label:    "Yard Poker: texas hold&rsquo;em poker app for friends",
					Filename: "yard-poker",
					Width:    1000,
					Height:   600,
					AltText:  "Mockup of a laptop displaying the Yard Poker web app",
				})
				@components.WorkItem(components.WorkItemProps{
					ID:       "think-shape",
					Label:    "Think Shape: fashion app empowering people to buy less and buy better",
					Filename: "think-shape",
					Width:    1000,
					Height:   600,
					AltText:  "Scattered iPhone mockups displaying various screens of the Think Shape app",
				})
				@components.WorkItem(components.WorkItemProps{
					ID:       "tradegraft",
					Label:    "Tradegraft: connecting construction sites with verified operators",
					Filename: "tradegraft",
					Width:    1000,
					Height:   600,
					AltText:  "Mockup of a laptop displaying the Tradegraft platform¥",
				})
			</section>
		</div>
	}
}
